{
  "name": "radio-colonia-pos-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:seed": "tsx src/db/seed.ts",
    "db:verify": "tsx scripts/verify-unified-db.ts",
    "arca:check": "node scripts/arca-wsaa-check.mjs",
    "arca:check:dev": "tsx scripts/arca-wsaa-check.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "postinstall": "patch-package && node scripts/ensure-arca-common-patch.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@ramiidv/arca-common": "^0.2.0",
    "@ramiidv/arca-facturacion": "^2.1.0",
    "dotenv": "^16.5.0",
    "fastify": "^5.3.3",
    "nodemailer": "^7.0.10",
    "patch-package": "^8.0.1",
    "pdfkit": "^0.17.2",
    "pg": "^8.16.0",
    "qrcode": "^1.5.4",
    "zod": "^3.24.2"
  },
  "overrides": {
    "@ramiidv/arca-facturacion": {
      "@ramiidv/arca-common": "$@ramiidv/arca-common"
    }
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "@types/nodemailer": "^6.4.17",
    "@types/pdfkit": "^0.13.9",
    "@types/pg": "^8.15.4",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11"
  }
}
