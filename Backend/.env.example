# Opción A: URL directa (misma base que ecommerce en producción)
DATABASE_URL=postgresql://radiocolonia:radiocolonia_secret@127.0.0.1:5433/radiocolonia_db

# Opción B: variables explícitas (mismo formato que Radio Colonia/app)
# DB_HOST=127.0.0.1
# DB_PORT=5433
# DB_USER=radiocolonia
# DB_PASSWORD=radiocolonia_secret
# DB_NAME=radiocolonia_db

# API
PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# No usar en producción (catálogo = ecommerce)
POS_SEED_DEMO=false

# Acceso POS (obligatorio en producción)
# PIN de caja (mín. 4; en prod usá alfanumérico largo). NO uses 1234.
POS_ACCESS_PIN=change-me-caja-pin
# PIN admin (analytics + contabilidad + clientes + fiscal). Opcional.
POS_ADMIN_PIN=change-me-admin-pin
# Rol del PIN de caja si no coincide admin: caja | admin
POS_DEFAULT_ROLE=caja
# Secreto para firmar JWT (mín. 16 caracteres; generá uno propio)
POS_JWT_SECRET=change-me-jwt-secret-min-16
# Duración de sesión en horas (default 12)
POS_SESSION_HOURS=12
# Exigir sesión de caja abierta para vender (true cuando el front ya gatea cobro)
POS_CAJA_REQUIRE_SESSION=true
# Ledger inventory_movements en venta/factura (requiere migración ecommerce 0022). Default off.
POS_STOCK_LEDGER_ENABLED=false

# Opcional: Bearer token para scripts (rol admin). Dejá vacío si no se usa.
# API_TOKEN=

# Facturación ARCA/AFIP — ARCA_ENABLED=kill switch; ARCA_PRODUCTION=homo/prod
ARCA_ENABLED=false
ARCA_CUIT=
ARCA_PTO_VTA=1
ARCA_PRODUCTION=false
ARCA_CERT_PATH=./certs/homo.crt
ARCA_KEY_PATH=./certs/homo.key

# Coolify: preferí PEM inline
# ARCA_CERT=
# ARCA_KEY=

# Membrete del PDF. La condición default del código es IVA Responsable Inscripto.
# FISCAL_EMISOR_RAZON_SOCIAL=Radio Colonia
# FISCAL_EMISOR_DOMICILIO=
# FISCAL_EMISOR_CONDICION_IVA=IVA Responsable Inscripto
# FISCAL_EMISOR_INGRESOS_BRUTOS=
# FISCAL_EMISOR_INICIO_ACTIVIDADES=

# Email del PDF. Sin HOST y FROM el POS no envía correos.
# INVOICE_SMTP_HOST=
# INVOICE_SMTP_PORT=587
# INVOICE_SMTP_SECURE=false
# INVOICE_SMTP_USER=
# INVOICE_SMTP_PASS=
# INVOICE_EMAIL_FROM=
# INVOICE_EMAIL_SUBJECT=Factura {{numero}} — Radio Colonia
# INVOICE_EMAIL_BODY=Adjuntamos la factura {{numero}} autorizada con CAE {{cae}}.
# INVOICE_SHARE_SECRET=
# INVOICE_SHARE_TTL_HOURS=72
# PUBLIC_API_URL=
