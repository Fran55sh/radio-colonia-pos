# Opción A: URL directa (misma base que ecommerce en producción)
DATABASE_URL=postgresql://radiocolonia:radiocolonia_secret@127.0.0.1:5433/radiocolonia_db

# Opción B: variables explícitas (mismo formato que Radio Colonia/app)
# DB_HOST=127.0.0.1
# DB_PORT=5433
# DB_USER=radiocolonia
# DB_PASSWORD=radiocolonia_secret
# DB_NAME=radiocolonia_db

# API
PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# No usar en producción (catálogo = ecommerce)
POS_SEED_DEMO=false

# Acceso POS (obligatorio en producción)
# PIN de caja (mín. 4; en prod usá alfanumérico largo). NO uses 1234.
POS_ACCESS_PIN=change-me-caja-pin
# PIN admin (compras + analytics + contabilidad + clientes + fiscal). Opcional.
POS_ADMIN_PIN=change-me-admin-pin
# PIN compras (caja + módulo compras). Opcional.
# POS_COMPRAS_PIN=change-me-compras-pin
# Rol del PIN de caja si no coincide admin/compras: caja | compras | admin
POS_DEFAULT_ROLE=caja
# Secreto para firmar JWT (mín. 16 caracteres; generá uno propio)
POS_JWT_SECRET=change-me-jwt-secret-min-16
# Duración de sesión en horas (default 12)
POS_SESSION_HOURS=12

# Opcional: Bearer token para scripts (rol admin). Dejá vacío si no se usa.
# API_TOKEN=

# PDFs de facturas de compra (privado, no servir estáticamente)
COMPRAS_PDF_DIR=/app/data/compras-pdfs

# Facturación ARCA/AFIP — ARCA_ENABLED=kill switch; ARCA_PRODUCTION=homo/prod
ARCA_ENABLED=false
ARCA_CUIT=
ARCA_PTO_VTA=1
ARCA_PRODUCTION=false
ARCA_CERT_PATH=./certs/homo.crt
ARCA_KEY_PATH=./certs/homo.key

# Coolify: preferí PEM inline
# ARCA_CERT=
# ARCA_KEY=
