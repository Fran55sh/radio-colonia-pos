# Copiar variables al stack Coolify (recurso docker-compose.coolify.yml)

# Misma base que el ecommerce
DB_HOST=tu-postgres-interno.coolify
DB_USER=radiocolonia
DB_PASSWORD=cambiar
DB_NAME=radiocolonia_db
DB_PORT=5432

# URL pública del frontend POS (CORS)
CORS_ORIGIN=https://pos.tudominio.com

# Opcional: API en otro dominio (rebuild frontend con este valor)
# VITE_API_URL=https://api-pos.tudominio.com/api/v1

# Opcional: proteger escrituras
# API_TOKEN=
