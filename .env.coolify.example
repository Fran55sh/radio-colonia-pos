# Copiar variables al stack Coolify (recurso docker-compose.yaml)
# Si algún valor de ejemplo se usó en producción: ROTAR PIN, JWT y DB password.

# Copiar las mismas DB_* que el stack del ecommerce (en Coolify suele ser DB_NAME=postgres)
# NO definas DATABASE_URL en el POS si contradice DB_* (DB_* tiene prioridad).
# Preferí un usuario least-privilege `pos_app` (ver docs/DEPLOY.md).
DB_HOST=<hostname-interno-postgres-coolify>
DB_USER=pos_app
DB_PASSWORD=<generar-password-fuerte>
DB_NAME=postgres
DB_PORT=5432

# El migrador del ecommerce crea pos_* (0005). El POS solo verifica al arrancar.
# Si el deploy del POS falla: correr migrador del ecommerce primero.

# URL pública del frontend POS (CORS)
CORS_ORIGIN=https://pos.tudominio.com

# Acceso caja (obligatorio en producción). PIN alfanumérico largo; no uses 1234.
POS_ACCESS_PIN=<pin-caja-largo>
POS_ADMIN_PIN=<pin-admin-largo>
POS_DEFAULT_ROLE=caja
POS_JWT_SECRET=<openssl-rand-base64-32>
POS_SESSION_HOURS=12
# Exigir sesión de caja abierta para vender (UI ya gatea cobro)
POS_CAJA_REQUIRE_SESSION=true

# Opcional: API en otro dominio (rebuild frontend con este valor)
# VITE_API_URL=https://api-pos.tudominio.com/api/v1

# Opcional: Bearer para scripts (rol admin). Vacío si no se usa.
# API_TOKEN=

# --- ARCA / AFIP ---
# Kill switch + homo/prod. En Coolify preferí ARCA_CERT / ARCA_KEY inline.
ARCA_ENABLED=false
ARCA_PRODUCTION=false
ARCA_CUIT=
ARCA_PTO_VTA=1
ARCA_CERT=
ARCA_KEY=
# ARCA_CERT_PATH=
# ARCA_KEY_PATH=
