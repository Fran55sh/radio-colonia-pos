# Copiar variables al stack Coolify (recurso docker-compose.yaml)

# Copiar las mismas DB_* que el stack del ecommerce (en Coolify suele ser DB_NAME=postgres)
# NO definas DATABASE_URL en el POS si contradice DB_* (DB_* tiene prioridad).
DB_HOST=qi0lrwpywbfez94gy9vfjbyf
DB_USER=postgres
DB_PASSWORD=cambiar
DB_NAME=postgres
DB_PORT=5432

# El migrador del ecommerce crea pos_* (0005). El POS solo verifica al arrancar.
# Si el deploy del POS falla: correr migrador del ecommerce primero.

# URL pública del frontend POS (CORS)
CORS_ORIGIN=https://pos.tudominio.com

# Acceso caja (obligatorio en producción)
POS_ACCESS_PIN=cambiar-pin-local
POS_JWT_SECRET=cambiar-secreto-jwt-min-16-chars
POS_SESSION_HOURS=12

# Opcional: API en otro dominio (rebuild frontend con este valor)
# VITE_API_URL=https://api-pos.tudominio.com/api/v1

# Opcional: Bearer para scripts/integraciones
# API_TOKEN=
